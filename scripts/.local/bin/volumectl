#!/bin/bash

sink="@DEFAULT_AUDIO_SINK@"

case "$1" in
"up")
  wpctl set-volume -l 1 "$sink" 5%+
  ;;
"down")
  wpctl set-volume "$sink" 5%-
  ;;
"mute")
  wpctl set-mute "$sink" toggle
  ;;
*)
  echo "Usage: $0 {up|down|mute}"
  exit 1
  ;;
esac

# Get current volume level as a clean percentage (e.g., "75")
response=$(wpctl get-volume "$sink")
muted=$(echo $response | grep -o "MUTED")
level=$(echo $response | awk '{print int($2 * 100)}')

if [[ -n "$muted" ]]; then
  notify-osd volume Volume Muted
else
  notify-osd volume Volume $level
fi
